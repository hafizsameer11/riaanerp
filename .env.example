# Copy to .env and adjust. Used by docker compose.
# Keep DB_PASS the same as MYSQL_ROOT_PASSWORD unless you create another MySQL user.

MYSQL_ROOT_PASSWORD=clientzone
MYSQL_DATABASE=clientzone

DB_HOST=db
DB_USER=root
DB_PASS=clientzone
DB_NAME=clientzone

# If XAMPP still uses 3306, map Docker MySQL to 3307: set MYSQL_PORT=3307
# MYSQL_PORT=3307
# WEB_PORT=8080
# PMA_PORT=8081
